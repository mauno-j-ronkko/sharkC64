//
// example11b
// An example using function calls with parameters and call chaining.
// This example moves colored blocks on the screen.
//
// Instructions:
// 1) make a persistent project: File > Persist Project
// 2) download color and screen modules: Help > Download Reference Library
// 3) run the project: Compiler > Run Project
//

module example11b
    use color, screen

    val backgroundColor := color.black
        topColor        := color.lightGray
        colorBits       := $0F
        char            := 160
        width           := 12
        height          := 7
        lastColumn      := 27
        lastRow         := 17

    var column, nextColumn        := 3
        row, nextRow              := 3
        rowStep, columnStep       := 1
        redOffset, brownOffset    : byte
        purpleOffset, greenOffset : byte


    fun drawBlock(left: byte, top: byte, color: byte)
        var row, column, right, bottom : byte
        is  right := left + width
            bottom := top + height
            for row := top to bottom do
                for column := left to right do
                    if (screen.color[row, column] and colorBits) < color then
                        screen.color[row, column] := color
                    end
                end
            end

    fun erase(column: byte, row: byte, color: byte) is
        if (screen.color[row, column] and colorBits) = color then
            screen.color[row, column] := backgroundColor
        end

    fun eraseColumn(column: byte, top: byte, color: byte)
        var row, bottom : byte
        is  bottom := top + height
            for row := top to bottom do erase(column, row, color) end

    fun eraseRow(left: byte, row: byte, color: byte)
        var column, right : byte
        is  right := left + width
            for column := left to right do erase(column, row, color) end

    fun moveByColumn() is
        column := nextColumn
        nextColumn := column + columnStep
        if nextColumn < 0 or nextColumn > lastColumn then nextColumn := column; columnStep := -columnStep end
        if columnStep = 1 then redOffset := 0 else redOffset := width end
        brownOffset := width - redOffset

    fun moveByRow() is
        row := nextRow
        nextRow := row + rowStep
        if nextRow < 0 or nextRow > lastRow then nextRow := row; rowStep := -rowStep end
        if rowStep = 1 then purpleOffset := 0 else purpleOffset := height end
        greenOffset := height - purpleOffset

    fun eraseOld() is
        eraseRow(22, row + purpleOffset, color.purple)
             .eraseRow(5, lastRow - row + greenOffset, color.green)
             .eraseColumn(column + redOffset, 2, color.red)
             .eraseColumn(lastColumn - column + brownOffset, 14, color.brown)

    fun drawNew() is
        drawBlock(nextColumn, 2, color.red)
             .drawBlock(22, nextRow, color.purple)
             .drawBlock(5, lastRow - nextRow, color.green)
             .drawBlock(lastColumn - nextColumn, 14, color.brown)


init
    screen.clear(char, backgroundColor)
    drawBlock(13, 8, topColor)
    while true do
        moveByColumn().moveByRow()
        eraseOld().drawNew()
    end
end